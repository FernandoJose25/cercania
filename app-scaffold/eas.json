{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "applicationArchivePath": "android/app/build/outputs/apk/release/cercania-v0.1.0.apk"
      },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_TRACKING_INTERVAL_MS": "600000",
        "EXPO_PUBLIC_TRACKING_DISTANCE_M": "50"
      },
      "channel": "preview"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_TRACKING_INTERVAL_MS": "600000",
        "EXPO_PUBLIC_TRACKING_DISTANCE_M": "50"
      },
      "channel": "production"
    }
  }
}
