# =====================================================================
# Cercanía - Variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).
# =====================================================================

# --- Supabase ---
# Dashboard > Settings > API > Project URL
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Dashboard > Settings > API > anon (public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- Mapbox ---
# Crear cuenta gratis en mapbox.com > Tokens > Create a token
# Token PÚBLICO (empieza con pk.) - puede ir en el código del cliente
EXPO_PUBLIC_MAPBOX_TOKEN=pk.tu-token-publico
MAPBOX_DOWNLOAD_TOKEN=sk.tu-token-secreto

# --- Configuración del tracker ---
EXPO_PUBLIC_TRACKING_INTERVAL_MS=600000
EXPO_PUBLIC_TRACKING_DISTANCE_M=50

# --- Modo ---
EXPO_PUBLIC_ENV=development
